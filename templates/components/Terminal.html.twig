<section class="terminal" id="terminal" aria-labelledby="terminal-title" data-turbo-permanent data-controller="terminal" data-ide-target="terminal inertWithDrawer" data-action="click->terminal#focusInput terminal:open->terminal#open terminal:complete->terminal#completed">
  <div class="terminal__header">
    <h2 class="terminal__title" id="terminal-title">Terminal</h2>
    <span class="terminal__session">Local</span>
    <span class="top-bar__spacer"></span>
    <button type="button" class="icon-button" aria-controls="terminal-body" aria-expanded="true" data-ide-target="terminalToggle" data-action="ide#toggleTerminal">
      {{ ux_icon('chevron-down', {class: 'icon terminal__toggle-icon'}) }}
      <span class="visually-hidden">Terminal panel</span>
    </button>
  </div>
  <twig:TerminalSession id="terminal-body" />
</section>
