{% props file, viewMode %}

<div class="view-modes" role="group" aria-label="View mode" data-turbo-prefetch="false">
  {% for mode, label in {code: 'Code', split: 'Split', preview: 'Preview'} %}
    <a class="view-modes__button" href="{{ path('app_file', {path: file.path, view: mode}) }}" title="{{ label }}" data-mode="{{ mode }}" data-view-mode-target="button" data-action="view-mode#choose"{% if mode == viewMode %} aria-current="true"{% endif %}>
      {{ ux_icon(mode, {class: 'icon'}) }}
      <span class="visually-hidden">{{ label }}</span>
    </a>
  {% endfor %}
</div>
