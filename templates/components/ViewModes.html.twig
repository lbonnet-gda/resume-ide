{% props file, viewMode %}

<div class="view-modes" role="group" aria-label="View mode" data-turbo-prefetch="false">
  {% for mode in enum('App\\Enum\\ViewMode').cases() %}
    <a class="view-modes__button" href="{{ path('app_file', {path: file.path, view: mode.value}) }}" title="{{ mode.name }}" data-mode="{{ mode.value }}" data-view-mode-target="button" data-action="view-mode#choose"{% if mode == viewMode %} aria-current="true"{% endif %}>
      {{ ux_icon(mode.value, {class: 'icon'}) }}
      <span class="visually-hidden">{{ mode.name }}</span>
    </a>
  {% endfor %}
</div>
