<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}resume-ide{% endblock %}</title>
    {% block meta %}{% endblock %}
    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    {# Turbo re-evaluates the scripts of an error page, and browsers reject a second import map. #}
    {{ importmap('app', {'data-turbo-track': 'reload', 'data-turbo-eval': 'false'}) }}
    <noscript><link rel="stylesheet" href="{{ asset('styles/noscript.css') }}"></noscript>
  </head>
  <body>
    {% block body %}{% endblock %}
  </body>
</html>
